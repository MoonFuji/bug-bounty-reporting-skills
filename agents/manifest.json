{
  "schema_version": 1,
  "entry_agent": "reporting-orchestrator",
  "certification_agent": "independent-triage-reviewer",
  "package_auditor": "final-package-auditor",
  "handoff_schema": "agents/assets/handoff.template.json",
  "pipeline_state_schema": "agents/assets/pipeline-state.template.json",
  "core_agents": [
    "reporting-orchestrator",
    "evidence-curator",
    "canonical-report-writer",
    "report-hardener",
    "independent-triage-reviewer",
    "platform-submission-adapter",
    "final-package-auditor"
  ],
  "specialist_agents": [
    "proof-reproduction-verifier",
    "impact-severity-analyst",
    "variant-radius-analyst",
    "remediation-engineer",
    "novelty-route-policy-analyst",
    "disclosure-safety-reviewer"
  ],
  "status_contracts": {
    "work": ["COMPLETE", "BLOCKED", "PROVISIONAL"],
    "report_review": ["READY", "BLOCKED", "PROVISIONAL"],
    "package_review": ["PACKAGE_READY", "BLOCKED", "PROVISIONAL"]
  },
  "pipeline": [
    {"from": "reporting-orchestrator", "to": "evidence-curator", "condition": "validated candidate or evidence bundle received"},
    {"from": "evidence-curator", "to": "canonical-report-writer", "condition": "portable report-input bundle complete"},
    {"from": "canonical-report-writer", "to": "report-hardener", "condition": "canonical report and manifest validate"},
    {"from": "report-hardener", "to": "proof-reproduction-verifier", "condition": "proof fidelity or reliability needs independent checking"},
    {"from": "report-hardener", "to": "impact-severity-analyst", "condition": "impact or severity may change"},
    {"from": "report-hardener", "to": "variant-radius-analyst", "condition": "affected radius is material or uncertain"},
    {"from": "report-hardener", "to": "remediation-engineer", "condition": "authoritative fix or regression control is unclear"},
    {"from": "report-hardener", "to": "novelty-route-policy-analyst", "condition": "scope, route, proof acceptance, or semantic novelty needs live verification"},
    {"from": "report-hardener", "to": "disclosure-safety-reviewer", "condition": "attachments or report may contain sensitive material"},
    {"from": "report-hardener", "to": "independent-triage-reviewer", "condition": "finished report, manifest, hardening record, and evidence are frozen"},
    {"from": "independent-triage-reviewer", "to": "platform-submission-adapter", "condition": "review verdict READY"},
    {"from": "platform-submission-adapter", "to": "final-package-auditor", "condition": "adaptation and attachment plan complete"}
  ],
  "agents": [
    {
      "name": "reporting-orchestrator",
      "file": "agents/reporting-orchestrator.md",
      "class": "core",
      "role": "orchestrator",
      "skills": ["write-vulnerability-report", "harden-vulnerability-report", "review-vulnerability-report", "adapt-vulnerability-report"],
      "fresh_context": "not_required",
      "sandbox": "workspace_write",
      "tools": ["filesystem_read", "filesystem_write", "shell"],
      "reads": ["user request", "validated candidate", "evidence bundle", "agent outputs"],
      "writes": ["pipeline-state.json", "handoffs/*.json"],
      "may_mutate_report": false,
      "may_certify_claim": false,
      "may_certify_package": false,
      "terminal_statuses": ["COMPLETE", "BLOCKED", "PROVISIONAL"]
    },
    {
      "name": "evidence-curator",
      "file": "agents/evidence-curator.md",
      "class": "core",
      "role": "evidence_normalizer",
      "skills": ["write-vulnerability-report"],
      "fresh_context": "not_required",
      "sandbox": "workspace_write",
      "tools": ["filesystem_read", "filesystem_write", "shell"],
      "reads": ["validated candidate", "proof artifacts", "policy artifacts"],
      "writes": ["report-input.json", "evidence-index.json", "evidence-owed.md"],
      "may_mutate_report": false,
      "may_certify_claim": false,
      "may_certify_package": false,
      "terminal_statuses": ["COMPLETE", "BLOCKED", "PROVISIONAL"]
    },
    {
      "name": "canonical-report-writer",
      "file": "agents/canonical-report-writer.md",
      "class": "core",
      "role": "writer",
      "skills": ["write-vulnerability-report"],
      "fresh_context": "not_required",
      "sandbox": "workspace_write",
      "tools": ["filesystem_read", "filesystem_write", "shell"],
      "reads": ["report-input.json", "evidence-index.json", "evidence artifacts"],
      "writes": ["report.md", "report-manifest.json"],
      "may_mutate_report": true,
      "may_certify_claim": false,
      "may_certify_package": false,
      "terminal_statuses": ["COMPLETE", "BLOCKED"]
    },
    {
      "name": "report-hardener",
      "file": "agents/report-hardener.md",
      "class": "core",
      "role": "hardening_synthesizer",
      "skills": ["harden-vulnerability-report"],
      "fresh_context": "recommended",
      "sandbox": "workspace_write",
      "tools": ["filesystem_read", "filesystem_write", "shell"],
      "reads": ["report.md", "report-manifest.json", "specialist review artifacts", "evidence artifacts"],
      "writes": ["report.md", "report-manifest.json", "hardening-record.json"],
      "may_mutate_report": true,
      "may_certify_claim": false,
      "may_certify_package": false,
      "terminal_statuses": ["COMPLETE", "BLOCKED"]
    },
    {
      "name": "proof-reproduction-verifier",
      "file": "agents/proof-reproduction-verifier.md",
      "class": "specialist",
      "role": "proof_verifier",
      "skills": ["harden-vulnerability-report", "review-vulnerability-report"],
      "fresh_context": "recommended",
      "sandbox": "workspace_write",
      "tools": ["filesystem_read", "filesystem_write", "shell"],
      "reads": ["report.md", "report-input.json", "proof artifacts", "target revision"],
      "writes": ["proof-review.json", "reproduction-transcript.txt"],
      "may_mutate_report": false,
      "may_certify_claim": false,
      "may_certify_package": false,
      "terminal_statuses": ["COMPLETE", "BLOCKED", "PROVISIONAL"]
    },
    {
      "name": "impact-severity-analyst",
      "file": "agents/impact-severity-analyst.md",
      "class": "specialist",
      "role": "impact_severity",
      "skills": ["harden-vulnerability-report"],
      "fresh_context": "recommended",
      "sandbox": "workspace_write",
      "tools": ["filesystem_read", "filesystem_write"],
      "reads": ["report.md", "report-manifest.json", "proof-review.json", "live severity policy"],
      "writes": ["severity-review.json"],
      "may_mutate_report": false,
      "may_certify_claim": false,
      "may_certify_package": false,
      "terminal_statuses": ["COMPLETE", "BLOCKED", "PROVISIONAL"]
    },
    {
      "name": "variant-radius-analyst",
      "file": "agents/variant-radius-analyst.md",
      "class": "specialist",
      "role": "radius_analysis",
      "skills": ["harden-vulnerability-report"],
      "fresh_context": "recommended",
      "sandbox": "workspace_write",
      "tools": ["filesystem_read", "filesystem_write", "shell"],
      "reads": ["report.md", "root-cause fingerprint", "target source and releases"],
      "writes": ["radius-review.json", "variant-leads.json"],
      "may_mutate_report": false,
      "may_certify_claim": false,
      "may_certify_package": false,
      "terminal_statuses": ["COMPLETE", "BLOCKED", "PROVISIONAL"]
    },
    {
      "name": "remediation-engineer",
      "file": "agents/remediation-engineer.md",
      "class": "specialist",
      "role": "remediation",
      "skills": ["harden-vulnerability-report"],
      "fresh_context": "recommended",
      "sandbox": "workspace_write",
      "tools": ["filesystem_read", "filesystem_write", "shell"],
      "reads": ["report.md", "technical trace", "proof artifacts", "target source"],
      "writes": ["remediation-review.json", "regression-control.md"],
      "may_mutate_report": false,
      "may_certify_claim": false,
      "may_certify_package": false,
      "terminal_statuses": ["COMPLETE", "BLOCKED", "PROVISIONAL"]
    },
    {
      "name": "novelty-route-policy-analyst",
      "file": "agents/novelty-route-policy-analyst.md",
      "class": "specialist",
      "role": "policy_route_novelty",
      "skills": ["harden-vulnerability-report", "adapt-vulnerability-report"],
      "fresh_context": "recommended",
      "sandbox": "workspace_write",
      "tools": ["filesystem_read", "filesystem_write", "network_read", "github_read"],
      "reads": ["report.md", "report-manifest.json", "live program policy", "issues", "pull requests", "advisories", "prior reports"],
      "writes": ["route-policy-review.json"],
      "may_mutate_report": false,
      "may_certify_claim": false,
      "may_certify_package": false,
      "terminal_statuses": ["COMPLETE", "BLOCKED", "PROVISIONAL"]
    },
    {
      "name": "disclosure-safety-reviewer",
      "file": "agents/disclosure-safety-reviewer.md",
      "class": "specialist",
      "role": "disclosure_safety",
      "skills": ["harden-vulnerability-report", "adapt-vulnerability-report"],
      "fresh_context": "recommended",
      "sandbox": "workspace_write",
      "tools": ["filesystem_read", "filesystem_write"],
      "reads": ["report.md", "attachments", "policy and safe-harbor artifacts"],
      "writes": ["safety-review.json", "redaction-plan.md"],
      "may_mutate_report": false,
      "may_certify_claim": false,
      "may_certify_package": false,
      "terminal_statuses": ["COMPLETE", "BLOCKED", "PROVISIONAL"]
    },
    {
      "name": "independent-triage-reviewer",
      "file": "agents/independent-triage-reviewer.md",
      "class": "core",
      "role": "final_claim_certifier",
      "skills": ["review-vulnerability-report"],
      "fresh_context": "required",
      "sandbox": "workspace_write",
      "tools": ["filesystem_read", "filesystem_write", "shell", "network_read", "github_read"],
      "reads": ["final report.md", "report-manifest.json", "report-input.json", "hardening-record.json", "evidence artifacts", "live target policy"],
      "writes": ["review.json", "review.md"],
      "may_mutate_report": false,
      "may_certify_claim": true,
      "may_certify_package": false,
      "terminal_statuses": ["READY", "BLOCKED", "PROVISIONAL"]
    },
    {
      "name": "platform-submission-adapter",
      "file": "agents/platform-submission-adapter.md",
      "class": "core",
      "role": "platform_adapter",
      "skills": ["adapt-vulnerability-report"],
      "fresh_context": "not_required",
      "sandbox": "workspace_write",
      "tools": ["filesystem_read", "filesystem_write", "network_read"],
      "reads": ["READY report.md", "report-manifest.json", "review.json", "live destination policy"],
      "writes": ["submission.md", "adaptation-manifest.json", "attachment-plan.md"],
      "may_mutate_report": false,
      "may_certify_claim": false,
      "may_certify_package": false,
      "terminal_statuses": ["COMPLETE", "BLOCKED", "PROVISIONAL"]
    },
    {
      "name": "final-package-auditor",
      "file": "agents/final-package-auditor.md",
      "class": "core",
      "role": "package_certifier",
      "skills": ["review-vulnerability-report", "adapt-vulnerability-report"],
      "fresh_context": "required",
      "sandbox": "workspace_write",
      "tools": ["filesystem_read", "filesystem_write", "shell"],
      "reads": ["report.md", "report-manifest.json", "review.json", "submission.md", "adaptation-manifest.json", "attachment-plan.md", "attachments"],
      "writes": ["package-audit.json"],
      "may_mutate_report": false,
      "may_certify_claim": false,
      "may_certify_package": true,
      "terminal_statuses": ["PACKAGE_READY", "BLOCKED", "PROVISIONAL"]
    }
  ]
}
